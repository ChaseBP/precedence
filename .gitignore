# ── secrets: never commit ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
keystore/
# Foundry writes broadcast/cache artifacts that can contain sensitive values.
contracts/cache/
contracts/broadcast/


*.log

# ── deps / build ───────────────────────────────────────────────────────────
node_modules/
out/
out-fork/
cache/
.next/
*.tsbuildinfo
contracts/lib/forge-std/

# ── scratch ────────────────────────────────────────────────────────────────
*.tmp

# ── session transcripts: internal, and can contain credentials pasted in chat ──
chat-log.txt
*-log.txt

# ── the nested repo we set aside (empty; kept only so the move is reversible) ──
precedence/.git.disabled-nested-repo/

# ── the latency sampler appends continuously; commit the summary, not the stream ──
evidence/latency.jsonl
evidence/latency-exp*.log
evidence/.active-collateral-id
evidence/stage-race.log
evidence/prove-race-*.log
evidence/.ux-store.json
# The app's persistent store when PRECEDENCE_STORE_PATH points here. Runtime state, not evidence:
# it churns on every action and holds whatever the machine was last looking at.
evidence/.store.json
